# Mongo
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=roombooker

# Crypto (32 bytes en hex = 64 caractères) — generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Session cookie signing — same generation method as above
SESSION_SECRET=

# Google OAuth (Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/google/callback
# En prod : https://roombooker.nmt.ovh/api/auth/google/callback

# Token random pour valider les push notifications Calendar — node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GOOGLE_WEBHOOK_TOKEN=

# Public URL (utilisé pour les liens magiques + redirect_uri OAuth + watch callback)
PUBLIC_APP_URL=http://localhost:3030
# En prod : https://roombooker.nmt.ovh

# SMS via EDJ Labs
EDJ_SMS_API_TOKEN=

# Email via Brevo (https://app.brevo.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RoomBooker

# Skedda
SKEDDA_VENUE_URL=https://antlerfrance.skedda.com

# Slack (désactivé en MVP)
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Domaine considéré "interne" — on déclenche un booking si ≥ 1 attendee NON dans ce domaine
INTERNAL_EMAIL_DOMAIN=muchbetter.ai
